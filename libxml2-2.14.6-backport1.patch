From 41ba80b9493569f3311f58ba2201a8b15bd94e6e Mon Sep 17 00:00:00 2001
From: ylwango613
Date: Fri, 20 Feb 2026 20:04:43 +0800
Subject: [PATCH] schematron: fix NULL pointer dereference in
 xmlSchematronParseRule

The return value of xmlMalloc at schematron.c:1007 was not checked for
NULL before being dereferenced. A memory allocation failure would cause
a write to address 0x8 (NULL + offset), resulting in a segmentation
fault.

Every other xmlMalloc call in schematron.c already has a proper NULL
check. This patch adds the missing check and frees the name, value, and
compiled XPath expression before returning to avoid memory leaks on the
error path.

Fix https://gitlab.gnome.org/GNOME/libxml2/-/issues/1059

 schematron.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/schematron.c b/schematron.c
index 0fd374617..32c0f571c 100644
--- a/schematron.c
+++ b/schematron.c
@@ -1051,1 +1051,8 @@ xmlSchematronParseRule(xmlSchematronParserCtxtPtr ctxt,
-            let = (xmlSchematronLetPtr) xmlMalloc(sizeof(xmlSchematronLet));
+            let = (xmlSchematronLetPtr) xmlMalloc(sizeof(xmlSchematronLet));
+            if (let == NULL) {
+                xmlSchematronPErrMemory(ctxt);
+                xmlFree(name);
+                xmlFree(value);
+                xmlXPathFreeCompExpr(var_comp);
+                return;
+            }
From f0e757a2a4e9e4da6ad522d7a389b7a06db8e9d0 Mon Sep 17 00:00:00 2001
From: ylwango613
Date: Fri, 20 Feb 2026 17:12:42 +0800
Subject: [PATCH] uri: fix signed integer overflow in xmlBuildRelativeURISafe

This patch changes the types of ix, nbslash, len, and pos from int to
size_t in xmlBuildRelativeURISafe. These variables are used to index
and measure path strings that can exceed INT_MAX bytes (~2.14 GB),
causing two independent signed integer overflow vulnerabilities.

1. The loop counter ix can overflow from INT_MAX to INT_MIN when
   traversing a base path longer than INT_MAX bytes, leading to an
   out-of-bounds read (CWE-125).

2. The expression 3 * nbslash in the xmlMalloc size argument can
   overflow int, resulting in an undersized allocation followed by
   a heap buffer overflow in the write loop (CWE-122).

An overflow check is also added before the xmlMalloc call to handle
the case where the size_t arithmetic would itself overflow.

Fix https://gitlab.gnome.org/GNOME/libxml2/-/issues/1062

 uri.c | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/uri.c b/uri.c
index cfeca1e01..f94473b43 100644
--- a/uri.c
+++ b/uri.c
@@ -2565,3 +2565,3 @@ xmlBuildRelativeURISafe(const xmlChar * URI, const xmlChar * base,
-    int ix;
-    int nbslash = 0;
-    int len;
+    size_t ix = 0;
+    size_t nbslash = 0;
+    size_t len = 0;
@@ -2648,1 +2648,1 @@ xmlBuildRelativeURISafe(const xmlChar * URI, const xmlChar * base,
-        int pos = 0;
+        size_t pos = 0;
@@ -2692,1 +2692,1 @@ xmlBuildRelativeURISafe(const xmlChar * URI, const xmlChar * base,
-	len = xmlStrlen (uptr) + 1;
+	len = (size_t) xmlStrlen (uptr) + 1;
@@ -2710,1 +2710,5 @@ xmlBuildRelativeURISafe(const xmlChar * URI, const xmlChar * base,
-    val = (xmlChar *) xmlMalloc (len + 3 * nbslash);
+    if (len + 3 * nbslash > SIZE_MAX) {
+        ret = -1;
+        goto done;
+    }
+    val = (xmlChar *) xmlMalloc (len + 3 * nbslash);
