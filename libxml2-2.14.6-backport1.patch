From 90f293ba74d28b1d570920382e707586f68ebf35 Mon Sep 17 00:00:00 2001
From: Daniel Garcia Moreno
Date: Mon, 4 May 2026 09:54:34 +0200
Subject: [PATCH] xmlIO: Check for int overflow before calling writecallback

Fix https://gitlab.gnome.org/GNOME/libxml2/-/work_items/1111

 xmlIO.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/xmlIO.c b/xmlIO.c
index ebe9b7c4e..847fdca21 100644
--- a/xmlIO.c
+++ b/xmlIO.c
@@ -2439,3 +2439,8 @@ xmlOutputBufferWrite(xmlOutputBuffer *out, int len, const char *data) {
-            if (nbchars < MINLEN)
-                break;
-
+            if (nbchars < MINLEN)
+                break;
+
+            if (nbchars >= INT_MAX) {
+                out->error = XML_ERR_INTERNAL_ERROR;
+                return(-1);
+            }
+
@@ -2648,11 +2648,21 @@ xmlOutputBufferFlush(xmlOutputBuffer *out) {
-    if ((out->conv != NULL) && (out->encoder != NULL) &&
-	(out->writecallback != NULL)) {
-	ret = out->writecallback(out->context,
-                                 (const char *)xmlBufContent(out->conv),
-                                 xmlBufUse(out->conv));
-	if (ret >= 0)
-	    xmlBufShrink(out->conv, ret);
-    } else if (out->writecallback != NULL) {
-	ret = out->writecallback(out->context,
-                                 (const char *)xmlBufContent(out->buffer),
-                                 xmlBufUse(out->buffer));
+    if ((out->conv != NULL) && (out->encoder != NULL) &&
+	(out->writecallback != NULL)) {
+        size_t bufsize = xmlBufUse(out->conv);
+        if (bufsize >= INT_MAX) {
+            out->error = XML_ERR_INTERNAL_ERROR;
+            return(-1);
+        }
+	ret = out->writecallback(out->context,
+                                 (const char *)xmlBufContent(out->conv),
+                                 bufsize);
+	if (ret >= 0)
+	    xmlBufShrink(out->conv, ret);
+    } else if (out->writecallback != NULL) {
+        size_t bufsize = xmlBufUse(out->buffer);
+        if (bufsize >= INT_MAX) {
+            out->error = XML_ERR_INTERNAL_ERROR;
+            return(-1);
+        }
+	ret = out->writecallback(out->context,
+                                 (const char *)xmlBufContent(out->buffer),
+                                 bufsize);
From 5e278b5a3de51f625d1ea54d8906d9fa5b398f15 Mon Sep 17 00:00:00 2001
From: rootvector2
Date: Sat, 16 May 2026 02:44:36 +0530
Subject: [PATCH] c14n: Check xmlGrowCapacity return in
 xmlC14NVisibleNsStackAdd

Commit 509d49812 ("c14n: Check reallocations for overflow") converted
the namespace-stack growth in xmlC14NVisibleNsStackAdd to xmlGrowCapacity
but omitted the `newSize < 0` check that every other xmlGrowCapacity
caller in the tree uses. When xmlGrowCapacity returns -1 (capacity
reached XML_MAX_ITEMS or would overflow size_t), the subsequent
xmlRealloc is invoked with a sign-extended (size_t)-1 multiplied by
the element size, falling back to the realloc OOM path instead of a
clean -1 return.

Add the check to match the convention used at the 59 other call sites
in the tree.

 c14n.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/c14n.c b/c14n.c
index 882e90387..6414cc529 100644
--- a/c14n.c
+++ b/c14n.c
@@ -315,3 +315,5 @@ xmlC14NVisibleNsStackAdd(xmlC14NVisibleNsStackPtr cur, xmlNsPtr ns, xmlNodePtr n
-        newSize = xmlGrowCapacity(cur->nsMax,
-                                  sizeof(tmp1[0]) + sizeof(tmp2[0]),
-                                  XML_NAMESPACES_DEFAULT, XML_MAX_ITEMS);
+        newSize = xmlGrowCapacity(cur->nsMax,
+                                  sizeof(tmp1[0]) + sizeof(tmp2[0]),
+                                  XML_NAMESPACES_DEFAULT, XML_MAX_ITEMS);
+        if (newSize < 0)
+            return (-1);
